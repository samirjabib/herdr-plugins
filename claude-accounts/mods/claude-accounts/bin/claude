#!/bin/sh
# The `claude` launcher of claude-accounts. Put this folder first on the PATH;
# the shell then runs this instead of Claude Code, and this runs Claude Code.
#
# Inside Herdr ($HC_TERMINAL_ID set) it picks the account's config folder:
#   0. the folder group-accounts pins to this checkout's mac-workspace group
#      (`<group><TAB><config dir>` lines in the state folder's group-accounts
#      file, e.g. cs -> the Coldsmoke login), so that group never runs on
#      another account, not even after a switch's restart; a pin to a folder
#      that does not exist is ignored;
#   1. CLAUDE_ACCOUNTS_DIR when set, even empty: the line a switch's restart
#      types (`CLAUDE_ACCOUNTS_DIR=<folder> claude ... --resume <id>`);
#   2. else the first line of ~/.config/herdr-app/claude-accounts/active;
#   3. else (no active file) the environment as it is.
# An empty folder means System default: CLAUDE_CONFIG_DIR is unset.
# In an ag, cs or personal folder, when ~/mac-workspace/harness/claude-profiles.tsv
# lists each account's org, no account the group may not use is handed on:
# personal/ runs any listed account or ~/.claude (all of Samir's accounts, only
# their Claude quota), cs/ and ag/ only their own org's (or an unlisted folder).
# An inherited CLAUDE_CONFIG_DIR that does not fit is unset, and a pick that
# does not fit is dropped (a wrapper then chooses) or, without a wrapper,
# replaced by the group's default row (personal: System default).
# Outside Herdr it changes nothing. Then it runs the next `claude` on the
# PATH that is not this script, with the same arguments.
#
# When that next `claude` is itself an account-aware wrapper (a script that
# reads CLAUDE_ACCOUNTS_DIR, like mac-workspace's bin/shims/claude, which keeps
# each org on its own accounts), the launcher hands it the pick as
# CLAUDE_ACCOUNTS_DIR and leaves CLAUDE_CONFIG_DIR alone: the wrapper decides,
# and the session name leaves the account out.

state="${CLAUDE_ACCOUNTS_HOME:-$HOME/.config/herdr-app/claude-accounts}"

self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$0") ;;
esac

next=
old_ifs=$IFS
IFS=:
for d in $PATH; do
  [ -n "$d" ] || d=.
  candidate="$d/claude"
  if [ -f "$candidate" ] && [ -x "$candidate" ] && ! [ "$candidate" -ef "$self" ]; then
    next=$candidate
    break
  fi
done
IFS=$old_ifs
if [ -z "$next" ]; then
  echo "claude-accounts launcher: no claude found on the PATH besides this script ($self)" >&2
  exit 127
fi

wrapper=0
if [ "$(head -c 2 "$next" 2>/dev/null)" = "#!" ] && grep -q CLAUDE_ACCOUNTS_DIR "$next" 2>/dev/null; then
  wrapper=1
fi

tab=$(printf '\t')

# The mac-workspace group of the current folder: its first component under
# ~/mac-workspace (ag, cs, personal, ...), if any.
ws_group() {
  ws=$(cd "$HOME/mac-workspace" 2>/dev/null && pwd -P) || return 1
  here=$(pwd -P 2>/dev/null) || return 1
  case $here/ in "$ws"/*/*) ;; *) return 1 ;; esac
  g=${here#"$ws"/}
  printf '%s\n' "${g%%/*}"
}

# The config folder group-accounts pins to $group, if any.
group_account() {
  map="$state/group-accounts"
  [ -n "$group" ] && [ -r "$map" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in "#"*|"") continue ;; esac
    [ "${line%%"$tab"*}" = "$group" ] || continue
    folder=${line#*"$tab"}
    [ -n "$folder" ] && [ "$folder" != "$line" ] && [ -d "$folder" ] || return 1
    printf '%s\n' "$folder"
    return 0
  done < "$map"
  return 1
}

# same_dir <a> <b>: one folder, under any spelling (~, a trailing /, a link).
same_dir() {
  a=$1 b=$2
  case $a in "~"*) a=$HOME${a#"~"} ;; esac
  case $b in "~"*) b=$HOME${b#"~"} ;; esac
  [ "${a%/}" = "${b%/}" ] || { [ -d "$a" ] && [ "$a" -ef "$b" ]; }
}

# mac-workspace lists each Claude account's org in harness/claude-profiles.tsv
# (`name<TAB>org<TAB>dir<TAB>default`). profile_row <dir>: "org<TAB>default"
# of the row whose dir is <dir>. profile_default <org>: the dir of that org's
# default row.
profiles="$HOME/mac-workspace/harness/claude-profiles.tsv"
profile_row() {
  [ -r "$profiles" ] || return 1
  while IFS="$tab" read -r name org pdir def rest || [ -n "$name" ]; do
    case $name in ""|"#"*|name) continue ;; esac
    same_dir "$1" "$pdir" && { printf '%s\t%s\n' "$org" "$def"; return 0; }
  done < "$profiles"
  return 1
}
profile_default() {
  [ -r "$profiles" ] || return 1
  while IFS="$tab" read -r name org pdir def rest || [ -n "$name" ]; do
    case $name in ""|"#"*|name) continue ;; esac
    [ "$org" = "$1" ] && [ "$def" = yes ] || continue
    case $pdir in "~"*) pdir=$HOME${pdir#"~"} ;; esac
    printf '%s\n' "$pdir"
    return 0
  done < "$profiles"
  return 1
}

# fits <dir>: the account in <dir> ("" = System default, ~/.claude) may run in
# $group, as mac-workspace's claude shim allows: personal/ ~/.claude or any
# listed account (Samir 2026-11-24: personal uses every account, only for its
# Claude quota); ag/ and cs/ an account of their own org or an unlisted folder.
# The folder group-accounts pins to the group always fits.
fits() {
  d=${1:-$HOME/.claude}
  [ -n "$pinned" ] && same_dir "$d" "$pinned" && return 0
  row=$(profile_row "$d") || row=
  org=${row%%"$tab"*}
  if [ "$group" = personal ]; then
    [ -n "$org" ] || same_dir "$d" "$HOME/.claude"
  else
    [ -z "$org" ] || [ "$org" = "$group" ]
  fi
}

# The account a group falls back to when a pick does not fit it: its default
# row, else (personal) System default. ~/.claude is System default too.
group_fallback() {
  if d=$(profile_default "$group"); then
    same_dir "$d" "$HOME/.claude" && d=
    printf '%s\n' "$d"
  elif [ "$group" = personal ]; then
    printf '\n'
  else
    return 1
  fi
}

if [ -n "${HC_TERMINAL_ID:-}" ]; then
  active="$state/active"
  # In an ag, cs or personal folder no account the group may not use is
  # handed on, not even one inherited from the session that opened this one (Claude Code
  # passes its CLAUDE_CONFIG_DIR to every terminal and agent it starts).
  # Only with harness/claude-profiles.tsv, which tells the launcher each
  # account's org; group-accounts pins work without it.
  group=$(ws_group) || group=
  pinned=$(group_account) || pinned=
  [ -r "$profiles" ] || group=
  case $group in ag|cs|personal) ;; *) group= ;; esac
  if [ -n "$group" ]; then
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && ! fits "$CLAUDE_CONFIG_DIR"; then
      unset CLAUDE_CONFIG_DIR
    fi
  fi
  pick=0
  if [ -n "$pinned" ]; then
    dir=$pinned
    pick=1
  elif [ "${CLAUDE_ACCOUNTS_DIR+set}" = set ]; then
    dir=$CLAUDE_ACCOUNTS_DIR
    pick=1
  elif [ -r "$active" ]; then
    IFS= read -r dir < "$active" || [ -n "$dir" ] || dir=
    pick=1
  fi
  if [ "$pick" = 1 ] && [ -n "$group" ] && ! fits "$dir"; then
    # A wrapper picks the group's own account itself; else the group's default.
    if [ "$wrapper" = 1 ]; then
      pick=0
    elif ! dir=$(group_fallback); then
      dir=
    fi
  fi
  if [ "$pick" = 1 ] && [ "$wrapper" = 1 ]; then
    CLAUDE_ACCOUNTS_DIR=$dir
    export CLAUDE_ACCOUNTS_DIR
  elif [ "$pick" = 1 ]; then
    if [ -n "$dir" ]; then
      CLAUDE_CONFIG_DIR=$dir
      export CLAUDE_CONFIG_DIR
    else
      unset CLAUDE_CONFIG_DIR
    fi
  fi
  [ "$wrapper" = 1 ] && [ "$pick" = 1 ] || unset CLAUDE_ACCOUNTS_DIR
fi

# Inside Herdr, in a mac-workspace checkout, the session gets a name that tells
# sessions apart at a glance (prompt box, /resume, Remote Control on the phone):
#   <Mac> · <project> · <worktree, or main> · <account>
# Not when a name is given by hand or for a print run. A resumed session keeps
# a name given with /rename (its transcript's last custom title) through a
# switch; an automatic one is made again, so it names the new account.
# Remote Control gets the same name, so the Claude app shows it too.

# The last /rename of session $1, from its transcript in the shared projects
# folder; nothing when it has none.
renamed_title() {
  for base in "${CLAUDE_ACCOUNTS_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}" "$HOME/.claude"; do
    for f in "$base"/projects/*/"$1".jsonl; do
      [ -r "$f" ] || continue
      grep -o '"customTitle":"\([^"\\]\|\\.\)*"' "$f" | tail -n 1 |
        sed -e 's/^"customTitle":"//' -e 's/"$//' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
      return 0
    done
  done
}

session_name() {
  ws=$(cd "$HOME/mac-workspace" 2>/dev/null && pwd -P) || return 1
  here=$(pwd -P 2>/dev/null) || return 1
  case $here/ in "$ws"/*) ;; *) return 1 ;; esac
  rel=${here#"$ws"/}
  rest=${rel#*/}
  project=${rest%%/*}
  [ "$project" != "$rest" ] || return 1
  rest=${rest#*/}
  case $rest/ in
    main/*) tree=main ;;
    worktrees/*/*) tree=${rest#worktrees/}; tree=${tree%%/*} ;;
    *) return 1 ;;
  esac
  id=
  [ -r "$HOME/.config/mac-workspace/host" ] && IFS= read -r id < "$HOME/.config/mac-workspace/host"
  [ -n "$id" ] || id=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
  id=$(printf %s "$id" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  mac=$(awk -F'\t' -v id="$id" '$2 == id { print $1; exit }' "$HOME/mac-workspace/hosts/aliases.tsv" 2>/dev/null)
  dot=$(printf '\302\267')
  name="${mac:-$id} $dot $project $dot $tree"
  accounts="$state/accounts.json"
  if [ "$wrapper" = 0 ] && [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -r "$accounts" ]; then
    i=0
    while dir=$(plutil -extract "$i.configDir" raw -o - "$accounts" 2>/dev/null); do
      if [ "$dir" = "$CLAUDE_CONFIG_DIR" ]; then
        who=$(plutil -extract "$i.org" raw -o - "$accounts" 2>/dev/null)
        case $who in
          ""|*"'s Organization") who=$(plutil -extract "$i.email" raw -o - "$accounts" 2>/dev/null); who=${who%%@*} ;;
        esac
        [ -n "$who" ] && name="$name $dot $who"
        break
      fi
      i=$((i + 1))
    done
  fi
  printf '%s' "$name"
}

if [ -n "${HC_TERMINAL_ID:-}" ]; then
  want=1
  # Only sessions get a name: not subcommands (`claude mcp list`, `claude update`)
  # nor --version / --help.
  case ${1-} in
    agents|attach|auth|auto-mode|config|doctor|gateway|import|install|kill|logs|mcp|migrate-installer|plugin|plugins|purge|respawn|rm|sessions|setup-token|stop|ultrareview|update|upgrade) want=0 ;;
  esac
  for a in "$@"; do
    case $a in -n|--name|--name=*|-p|--print|-v|--version|-h|--help|-c|--continue) want=0 ;; esac
  done
  # A resume that names no session (the picker) may open a renamed one: no name.
  prev=
  for a in "$@" --; do
    case $prev in --resume|-r) case $a in -*) want=0 ;; esac ;; esac
    prev=$a
  done
  if [ "$want" = 1 ] && name=$(session_name) && [ -n "$name" ]; then
    sid='' prev=''
    for a in "$@"; do
      case $prev in --resume|-r) sid=$a ;; esac
      case $a in --resume=*) sid=${a#--resume=} ;; esac
      prev=$a
    done
    if [ -n "$sid" ]; then
      title=$(renamed_title "$sid")
      # The automatic name is "<Mac> · <project> · <worktree>" plus an account.
      d=" $(printf '\302\267') "
      r=$name; auto=${r%%"$d"*}; r=${r#*"$d"}; auto="$auto$d${r%%"$d"*}"; r=${r#*"$d"}; auto="$auto$d${r%%"$d"*}"
      case $title in
        ""|"$auto"|"$auto$d"*) ;;
        *) name=$title ;;
      esac
    fi
    # A bare --remote-control (no name after it) takes the session's name.
    rc=0
    for a in "$@"; do
      [ "$rc" = 0 ] && set --
      if [ "$rc" = 2 ]; then
        case $a in -*) set -- "$@" "$name" ;; esac
      fi
      rc=1
      set -- "$@" "$a"
      [ "$a" = --remote-control ] && rc=2
    done
    [ "$rc" = 2 ] && set -- "$@" "$name"
    set -- --name "$name" "$@"
  fi
fi

exec "$next" "$@"
